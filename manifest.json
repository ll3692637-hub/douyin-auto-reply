{
  "manifest_version": 3,
  "name": "直播自动回复助手",
  "version": "3.0.0",
  "description": "抖音/视频号直播间公屏弹幕关键词自动回复工具，支持规则管理、智能匹配、防刷屏；新增监听模式（弹幕采集+主播音频转写）",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "直播自动回复",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://live.douyin.com/*"
      ],
      "js": [
        "content/ws-patch.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://live.douyin.com/*"
      ],
      "js": [
        "content/metrics_parse.js",
        "content/product_parse.js",
        "content/diag.js",
        "content/content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://channels.weixin.qq.com/*"
      ],
      "js": [
        "content/content_channels.js"
      ],
      "run_at": "document_end"
    }
  ],
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "options/diagnose.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "tabCapture",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "*://live.douyin.com/*",
    "*://channels.weixin.qq.com/*",
    "http://127.0.0.1:17842/*"
  ]
}